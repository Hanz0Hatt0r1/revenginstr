{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/ghidra-caller-argument-subtree-v1.schema.json",
  "title": "REVENGINSTR.GhidraCallerArgumentSubtree/1 TSV row",
  "description": "One metadata-only node or summary row from a bounded High P-code argument-flow export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "row_type", "plan_id", "callee_entry", "parameter_index",
    "direct_caller_functions", "caller_functions_decompiled", "caller_functions_failed",
    "callers_with_matched_calls", "matched_caller_calls", "caller_entry", "caller_name",
    "caller_call_site", "node_id", "parent_node_id", "input_index", "depth", "edge_kind",
    "node_token", "type_display", "pointer_depth", "pointee_type_display", "constant_value",
    "defining_opcode", "defining_address", "defining_time", "call_target_entry",
    "call_target_name", "truncation", "status"
  ],
  "properties": {
    "format": {"const": "REVENGINSTR.GhidraCallerArgumentSubtree/1"},
    "row_type": {"enum": ["node", "summary"]},
    "plan_id": {"type": "string", "minLength": 1},
    "callee_entry": {"type": "string", "minLength": 1},
    "parameter_index": {"type": "string", "pattern": "^[0-9]+$"},
    "direct_caller_functions": {"type": "string", "pattern": "^(?:-|[0-9]+)$"},
    "caller_functions_decompiled": {"type": "string", "pattern": "^(?:-|[0-9]+)$"},
    "caller_functions_failed": {"type": "string", "pattern": "^(?:-|[0-9]+)$"},
    "callers_with_matched_calls": {"type": "string", "pattern": "^(?:-|[0-9]+)$"},
    "matched_caller_calls": {"type": "string", "pattern": "^(?:-|[0-9]+)$"},
    "caller_entry": {"type": "string"},
    "caller_name": {"type": "string"},
    "caller_call_site": {"type": "string"},
    "node_id": {"type": "string", "pattern": "^(?:-|[0-9]+)$"},
    "parent_node_id": {"type": "string", "pattern": "^(?:-|-[0-9]+|[0-9]+)$"},
    "input_index": {"type": "string", "pattern": "^(?:-|-[0-9]+|[0-9]+)$"},
    "depth": {"type": "string", "pattern": "^(?:-|[0-9]+)$"},
    "edge_kind": {"type": "string"},
    "node_token": {"type": "string"},
    "type_display": {"type": "string"},
    "pointer_depth": {"type": "string", "pattern": "^(?:-|[0-9]+)$"},
    "pointee_type_display": {"type": "string"},
    "constant_value": {"type": "string"},
    "defining_opcode": {"type": "string"},
    "defining_address": {"type": "string"},
    "defining_time": {"type": "string", "pattern": "^(?:-|[0-9]+)$"},
    "call_target_entry": {"type": "string"},
    "call_target_name": {"type": "string"},
    "truncation": {"type": "string"},
    "status": {"type": "string"}
  }
}
