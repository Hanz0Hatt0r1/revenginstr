{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/runtime-direct-call-correlation-v1.schema.json",
  "title": "REVENGINSTR.RuntimeDirectCallCorrelation/1",
  "description": "Hash-pinned joins from bounded runtime direct-call observations to exact CALL operations, owners, and executed target functions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "capture_id", "program_id", "program_sha256", "static_identity_sha256", "semantic_graph_sha256", "capture_manifest_sha256", "observations_sha256", "address_mapping", "sampling", "summary", "events"],
  "properties": {
    "format": {"const": "REVENGINSTR.RuntimeDirectCallCorrelation/1"},
    "capture_id": {"type": "string", "minLength": 1},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "static_identity_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_graph_sha256": {"$ref": "#/$defs/sha256"},
    "capture_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "observations_sha256": {"$ref": "#/$defs/sha256"},
    "address_mapping": {"$ref": "#/$defs/addressMapping"},
    "sampling": {"$ref": "#/$defs/sampling"},
    "summary": {"$ref": "#/$defs/summary"},
    "events": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "address": {"type": "string", "pattern": "^(?:0x)?[0-9a-fA-F]{1,16}$"},
    "addressMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "runtime_module_base", "static_image_base", "module_delta"],
      "properties": {
        "method": {"const": "runtime_address_minus_module_delta"},
        "runtime_module_base": {"$ref": "#/$defs/address"},
        "static_image_base": {"$ref": "#/$defs/address"},
        "module_delta": {"type": "string", "pattern": "^-?0x[0-9a-f]+$"}
      }
    },
    "sampling": {
      "type": "object", "additionalProperties": false, "required": ["status", "gaps"],
      "properties": {
        "status": {"enum": ["complete", "sampled", "unknown"]},
        "gaps": {
          "type": "array", "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["first_sequence", "last_sequence", "reason"],
            "properties": {
              "first_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
              "last_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["event_count", "match_state_counts"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "match_state_counts": {
          "type": "object",
          "propertyNames": {"enum": ["matched", "unmatched_callsite", "ambiguous_callsite", "unmatched_caller", "ambiguous_caller", "unmatched_target", "ambiguous_target", "mapping_underflow", "mapping_overflow", "static_target_unavailable", "static_target_unresolved", "static_target_ambiguous", "static_target_mismatch"]},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "nodeIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "staticEntries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:0x)?[0-9a-fA-F]{1,16}$"}},
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["capture_id", "sequence", "callsite_runtime_address", "target_runtime_address", "callsite_address", "caller_addresses", "target_address", "callsite_match_state", "caller_match_state", "target_match_state", "static_target_match_state", "callsite_node_ids", "caller_node_ids", "target_node_ids", "static_target_entries", "match_state"],
      "properties": {
        "capture_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "callsite_runtime_address": {"$ref": "#/$defs/address"},
        "target_runtime_address": {"$ref": "#/$defs/address"},
        "callsite_address": {"anyOf": [{"$ref": "#/$defs/address"}, {"type": "null"}]},
        "caller_addresses": {"$ref": "#/$defs/staticEntries"},
        "target_address": {"anyOf": [{"$ref": "#/$defs/address"}, {"type": "null"}]},
        "callsite_match_state": {"enum": ["matched", "unmatched", "ambiguous", "mapping_underflow", "mapping_overflow"]},
        "caller_match_state": {"enum": ["matched", "unmatched", "ambiguous"]},
        "target_match_state": {"enum": ["matched", "unmatched", "ambiguous", "mapping_underflow", "mapping_overflow"]},
        "static_target_match_state": {"enum": ["matched", "unavailable", "unresolved", "ambiguous", "mismatch", "mapping_underflow", "mapping_overflow"]},
        "callsite_node_ids": {"$ref": "#/$defs/nodeIds"},
        "caller_node_ids": {"$ref": "#/$defs/nodeIds"},
        "target_node_ids": {"$ref": "#/$defs/nodeIds"},
        "static_target_entries": {"$ref": "#/$defs/staticEntries"},
        "match_state": {"enum": ["matched", "unmatched_callsite", "ambiguous_callsite", "unmatched_caller", "ambiguous_caller", "unmatched_target", "ambiguous_target", "mapping_underflow", "mapping_overflow", "static_target_unavailable", "static_target_unresolved", "static_target_ambiguous", "static_target_mismatch"]}
      }
    }
  }
}
