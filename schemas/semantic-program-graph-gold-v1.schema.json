{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/semantic-program-graph-gold-v1.schema.json",
  "title": "REVENGINSTR.SemanticProgramGraphGold/1 JSONL row",
  "description": "One consumer-owned, adjudicated gold subgraph with explicitly complete relations and references to source evidence outside the graph output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "subgraph_id", "dataset_id", "split_id", "program_id", "graph_id",
    "scope_node_ids", "complete_relations", "edges", "adjudication_status"
  ],
  "properties": {
    "format": {"const": "REVENGINSTR.SemanticProgramGraphGold/1"},
    "subgraph_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "split_id": {"type": "string", "minLength": 1},
    "program_id": {"type": "string", "minLength": 1},
    "graph_id": {"type": "string", "pattern": "^program:[0-9a-f]{64}$"},
    "scope_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/node_id"}
    },
    "complete_relations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["contains", "calls", "reads", "writes", "observes_receiver"]}
    },
    "edges": {"type": "array", "items": {"$ref": "#/$defs/gold_edge"}},
    "adjudication_status": {"const": "adjudicated"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node_id": {"type": "string", "pattern": "^(program|function|operation|field|receiver_observation):[0-9a-f]{64}$"},
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "record_index", "source_format"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "record_index": {"type": "integer", "minimum": 1},
        "source_format": {"type": "string", "minLength": 1}
      }
    },
    "gold_edge": {
      "type": "object",
      "additionalProperties": false,
      "description": "An adjudicated edge whose source and target node kinds must be valid for its relation.",
      "required": ["from", "to", "relation", "evidence_refs"],
      "properties": {
        "from": {"$ref": "#/$defs/node_id"},
        "to": {"$ref": "#/$defs/node_id"},
        "relation": {"enum": ["contains", "calls", "reads", "writes", "observes_receiver"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      },
      "oneOf": [
        {
          "properties": {
            "relation": {"const": "contains"},
            "from": {"pattern": "^program:"},
            "to": {"pattern": "^function:"}
          }
        },
        {
          "properties": {
            "relation": {"const": "contains"},
            "from": {"pattern": "^function:"},
            "to": {"pattern": "^(operation|receiver_observation):"}
          }
        },
        {
          "properties": {
            "relation": {"const": "calls"},
            "from": {"pattern": "^operation:"},
            "to": {"pattern": "^function:"}
          }
        },
        {
          "properties": {
            "relation": {"const": "reads"},
            "from": {"pattern": "^operation:"},
            "to": {"pattern": "^field:"}
          }
        },
        {
          "properties": {
            "relation": {"const": "writes"},
            "from": {"pattern": "^operation:"},
            "to": {"pattern": "^field:"}
          }
        },
        {
          "properties": {
            "relation": {"const": "observes_receiver"},
            "from": {"pattern": "^operation:"},
            "to": {"pattern": "^receiver_observation:"}
          }
        }
      ]
    }
  }
}
