{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/runtime-probe-evaluation-manifest-v1.schema.json",
  "title": "REVENGINSTR.RuntimeProbeEvaluationManifest/1",
  "description": "Pins a selected bounded native-probe plan and caller-supplied predictions for a fixed unresolved set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "evaluation_id", "plan_sha256", "source_unresolved_set_sha256", "candidates"],
  "properties": {
    "format": {"const": "REVENGINSTR.RuntimeProbeEvaluationManifest/1"},
    "evaluation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "source_unresolved_set_sha256": {"$ref": "#/$defs/sha256"},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "static_prediction", "uncertainty_before_milli", "minimum_narrowing_milli"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "static_prediction": {"enum": ["accept", "reject", "unresolved"]},
        "uncertainty_before_milli": {"type": "integer", "minimum": 1, "maximum": 1000},
        "minimum_narrowing_milli": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    }
  }
}
