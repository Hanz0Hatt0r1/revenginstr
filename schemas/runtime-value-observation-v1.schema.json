{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/runtime-value-observation-v1.schema.json",
  "title": "REVENGINSTR.RuntimeValueObservation/1",
  "description": "One consumer-generated value observation tied to a sequence in a RuntimeStaticCorrelation/1 report. Token strings are opaque HMAC-shaped labels, not values the analyzer can authenticate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "capture_id", "correlation_sequence", "event_kind", "runtime_address", "tokens"],
  "properties": {
    "format": {"const": "REVENGINSTR.RuntimeValueObservation/1"},
    "capture_id": {"type": "string", "minLength": 1},
    "correlation_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "event_kind": {"enum": ["receiver", "field_write", "field_read", "state_before", "state_after", "factory_return", "factory_use", "allocation", "release"]},
    "runtime_address": {"type": "string", "pattern": "^(0x)?[0-9a-fA-F]{1,16}$"},
    "tokens": {"$ref": "#/$defs/tokens"}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"},
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {"$ref": "#/$defs/token"},
        "field": {"$ref": "#/$defs/token"},
        "value": {"$ref": "#/$defs/token"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"event_kind": {"const": "receiver"}}, "required": ["event_kind"]}, "then": {"properties": {"tokens": {"required": ["subject"]}}}},
    {"if": {"properties": {"event_kind": {"enum": ["field_write", "field_read"]}}, "required": ["event_kind"]}, "then": {"properties": {"tokens": {"required": ["subject", "field", "value"]}}}},
    {"if": {"properties": {"event_kind": {"enum": ["state_before", "state_after"]}}, "required": ["event_kind"]}, "then": {"properties": {"tokens": {"required": ["subject", "value"]}}}},
    {"if": {"properties": {"event_kind": {"enum": ["factory_return", "factory_use", "allocation", "release"]}}, "required": ["event_kind"]}, "then": {"properties": {"tokens": {"required": ["subject"]}}}}
  ]
}
