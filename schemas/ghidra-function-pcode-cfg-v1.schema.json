{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/ghidra-function-pcode-cfg-v1.schema.json",
  "title": "REVENGINSTR.GhidraFunctionPcodeCFG/1 JSONL row",
  "description": "High-P-code basic blocks, operation sequence locations, and control-flow successors for one function in an opaque caller-identified program.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "program_id", "function_entry", "blocks"],
  "properties": {
    "format": {"const": "REVENGINSTR.GhidraFunctionPcodeCFG/1"},
    "program_id": {"type": "string", "minLength": 1},
    "function_entry": {"type": "string", "minLength": 1},
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "time", "opcode"],
      "properties": {
        "address": {"type": "string", "minLength": 1},
        "time": {"type": "integer", "minimum": 0},
        "opcode": {"type": "string", "minLength": 1}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_index", "start_address", "stop_address", "operations", "successors"],
      "properties": {
        "block_index": {"type": "integer", "minimum": 0},
        "start_address": {"type": "string", "minLength": 1},
        "stop_address": {"type": "string", "minLength": 1},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "successors": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      }
    }
  }
}
