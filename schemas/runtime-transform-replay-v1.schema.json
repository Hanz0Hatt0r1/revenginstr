{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/runtime-transform-replay-v1.schema.json",
  "title": "REVENGINSTR.RuntimeTransformReplay/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "capture_id", "candidate_id", "behavior_id", "expected_function_node_id", "manifest_sha256", "correlation_report_sha256", "observations_sha256", "source_capture_sha256", "probe_script_sha256", "sampling", "summary", "observations", "evidence_limitations"],
  "properties": {
    "format": {"const": "REVENGINSTR.RuntimeTransformReplay/1"},
    "capture_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "behavior_id": {"type": "string", "minLength": 1},
    "expected_function_node_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "correlation_report_sha256": {"$ref": "#/$defs/sha256"},
    "observations_sha256": {"$ref": "#/$defs/sha256"},
    "source_capture_sha256": {"$ref": "#/$defs/sha256"},
    "probe_script_sha256": {"$ref": "#/$defs/sha256"},
    "sampling": {"$ref": "#/$defs/sampling"},
    "summary": {"$ref": "#/$defs/summary"},
    "observations": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/observation"}},
    "evidence_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sampling": {
      "type": "object", "additionalProperties": false, "required": ["status", "gaps"],
      "properties": {
        "status": {"enum": ["complete", "sampled", "unknown"]},
        "gaps": {
          "type": "array", "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["first_sequence", "last_sequence", "reason"],
            "properties": {
              "first_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
              "last_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_count", "exact_static_match_count", "full_match_count", "sampled_match_count", "observed_mismatch_count", "inconclusive_count"],
      "properties": {
        "observation_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "exact_static_match_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "full_match_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "sampled_match_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "observed_mismatch_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "inconclusive_count": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["correlation_sequence", "runtime_address", "source_ordinal", "static_match_state", "matched_node_ids", "input_length", "key", "sample_mode", "sample_count", "formula_result", "outcome", "evidence_class"],
      "properties": {
        "correlation_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "runtime_address": {"type": "string", "pattern": "^0x[0-9a-f]{1,16}$"},
        "source_ordinal": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "static_match_state": {"enum": ["matched", "ambiguous", "unmatched", "mapping_underflow", "mapping_overflow", "missing"]},
        "matched_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "input_length": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "key": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "sample_mode": {"enum": ["none", "full", "bounded"]},
        "sample_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "formula_result": {"enum": ["match", "mismatch", "unavailable"]},
        "outcome": {"enum": ["full_match", "sampled_match", "observed_mismatch", "inconclusive"]},
        "evidence_class": {"const": "runtime_consumer_reported"}
      }
    }
  }
}
