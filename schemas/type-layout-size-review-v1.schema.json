{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/type-layout-size-review-v1.schema.json",
  "title": "REVENGINSTR.TypeLayoutSizeReview/1 record",
  "description": "Reviewer-supplied exact object size tied to pinned program and source evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "program_id", "program_sha256", "type_id", "exact_size_bytes", "evidence"],
  "properties": {
    "format": {"const": "REVENGINSTR.TypeLayoutSizeReview/1"},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "type_id": {"type": "string", "minLength": 1},
    "exact_size_bytes": {"type": "integer", "minimum": 1},
    "evidence": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_format", "source_sha256", "record_key", "source_pointer", "evidence_class"],
      "properties": {
        "source_format": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "record_key": {"type": "string", "minLength": 1},
        "source_pointer": {"type": "string", "minLength": 1},
        "evidence_class": {"enum": ["exact_static", "runtime_native", "derived_structural", "human_review", "interventional_probe"]}
      }
    }
  }
}
