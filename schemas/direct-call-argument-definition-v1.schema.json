{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/direct-call-argument-definition-v1.schema.json",
  "title": "REVENGINSTR.DirectCallArgumentDefinition/1 JSONL record",
  "description": "Exact P-code definition-row matches for direct-call value tokens; this does not infer argument type, meaning, or runtime value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "program_id", "program_sha256", "caller_entry", "callee_entry",
    "call_address", "call_time", "argument_index", "argument_count",
    "value_token", "width_bytes", "resolution_state", "call_observation_ref",
    "call_pcode_evidence_ref", "definition_evidence_refs"
  ],
  "properties": {
    "format": {"const": "REVENGINSTR.DirectCallArgumentDefinition/1"},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "caller_entry": {"$ref": "#/$defs/address"},
    "callee_entry": {"$ref": "#/$defs/address"},
    "call_address": {"$ref": "#/$defs/address"},
    "call_time": {"type": "integer", "minimum": 0},
    "argument_index": {"type": "integer", "minimum": 0},
    "argument_count": {"type": "integer", "minimum": 0},
    "value_token": {"type": "string", "minLength": 1},
    "width_bytes": {"type": "integer", "minimum": 1},
    "resolution_state": {"enum": ["exact_definition", "definition_not_found", "ambiguous_definition", "non_definition_token"]},
    "call_observation_ref": {"$ref": "#/$defs/call_observation_ref"},
    "call_pcode_evidence_ref": {"$ref": "#/$defs/pcode_evidence_ref"},
    "definition_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/pcode_evidence_ref"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"resolution_state": {"const": "exact_definition"}}, "required": ["resolution_state"]},
      "then": {"properties": {"definition_evidence_refs": {"minItems": 1, "maxItems": 1}}}
    },
    {
      "if": {"properties": {"resolution_state": {"const": "ambiguous_definition"}}, "required": ["resolution_state"]},
      "then": {"properties": {"definition_evidence_refs": {"minItems": 2}}}
    },
    {
      "if": {"properties": {"resolution_state": {"enum": ["definition_not_found", "non_definition_token"]}}, "required": ["resolution_state"]},
      "then": {"properties": {"definition_evidence_refs": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "address": {"type": "string", "pattern": "^(?:[A-Za-z_$][\\w$]*:)?(?:0x)?[0-9a-fA-F]+$"},
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "record_index", "source_format"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "record_index": {"type": "integer", "minimum": 1},
        "source_format": {"type": "string", "minLength": 1}
      }
    },
    "call_observation_ref": {
      "allOf": [
        {"$ref": "#/$defs/evidence_ref"},
        {"properties": {"source_format": {"const": "REVENGINSTR.DirectCallArgumentObservation/1"}}}
      ]
    },
    "pcode_evidence_ref": {
      "allOf": [
        {"$ref": "#/$defs/evidence_ref"},
        {"properties": {"source_format": {"const": "REVENGINSTR.GhidraFunctionPcodeFlow/1"}}}
      ]
    }
  }
}
