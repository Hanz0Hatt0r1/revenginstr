{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/function-prototype-hypothesis-v1.schema.json",
  "title": "REVENGINSTR.FunctionPrototypeHypothesis/1 record",
  "description": "Evidence-linked candidate function signatures; candidate confidence is a score, not adjudicated truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "program_id", "program_sha256", "architecture", "function_entry", "status", "candidates", "conflicts"],
  "properties": {
    "format": {"const": "REVENGINSTR.FunctionPrototypeHypothesis/1"},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "architecture": {"$ref": "#/$defs/architecture"},
    "function_entry": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "review", "conflicted"]},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "conflicted"}}, "required": ["status"]},
    "then": {"properties": {"conflicts": {"minItems": 1}}}
  }],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "architecture": {
      "type": "object", "additionalProperties": false,
      "required": ["language_id", "pointer_width_bytes", "endianness"],
      "properties": {
        "language_id": {"type": "string", "minLength": 1},
        "pointer_width_bytes": {"type": "integer", "minimum": 1},
        "endianness": {"enum": ["little", "big"]}
      }
    },
    "evidence_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_sha256", "record_index", "source_format"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "record_index": {"type": "integer", "minimum": 1},
        "source_format": {"type": "string", "minLength": 1}
      }
    },
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "kind", "width_bytes"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["pointer", "reference", "scalar", "aggregate", "unknown"]},
        "width_bytes": {"type": ["integer", "null"], "minimum": 1},
        "target_type_id": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"target_type_id": {"type": "string"}}, "required": ["target_type_id"]}, "then": {"properties": {"kind": {"enum": ["pointer", "reference"]}}}}]
    },
    "return_value": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "width_bytes"],
      "properties": {
        "kind": {"enum": ["void", "pointer", "reference", "scalar", "aggregate", "unknown"]},
        "width_bytes": {"type": ["integer", "null"], "minimum": 1},
        "target_type_id": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"target_type_id": {"type": "string"}}, "required": ["target_type_id"]}, "then": {"properties": {"kind": {"enum": ["pointer", "reference"]}}}}]
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "parameter_count", "calling_convention", "parameters", "return_value", "receiver_parameter_index", "confidence", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "parameter_count": {"type": ["integer", "null"], "minimum": 0},
        "calling_convention": {"type": ["string", "null"], "minLength": 1},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
        "return_value": {"$ref": "#/$defs/return_value"},
        "receiver_parameter_index": {"type": ["integer", "null"], "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["reason", "evidence_refs"],
      "properties": {
        "reason": {"enum": ["incompatible_parameter_counts", "calling_convention_conflict", "return_shape_conflict", "receiver_identity_conflict", "evidence_conflict", "other"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    }
  }
}
