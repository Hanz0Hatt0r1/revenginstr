{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/runtime-static-correlation-v1.schema.json",
  "title": "REVENGINSTR.RuntimeStaticCorrelation/1",
  "description": "Deterministic exact-address joins from one runtime capture to one hash-pinned SemanticProgramGraph/3; unmatched, ambiguous, and out-of-range normalized addresses remain explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "capture_id", "program_id", "program_sha256", "static_identity_sha256", "semantic_graph_sha256", "capture_manifest_sha256", "observations_sha256", "address_mapping", "sampling", "summary", "events"],
  "properties": {
    "format": {"const": "REVENGINSTR.RuntimeStaticCorrelation/1"},
    "capture_id": {"type": "string", "minLength": 1},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "static_identity_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_graph_sha256": {"$ref": "#/$defs/sha256"},
    "capture_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "observations_sha256": {"$ref": "#/$defs/sha256"},
    "address_mapping": {"$ref": "#/$defs/addressMapping"},
    "sampling": {"$ref": "#/$defs/sampling"},
    "summary": {"$ref": "#/$defs/summary"},
    "events": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "address": {"type": "string", "pattern": "^0x[0-9a-f]{1,16}$"},
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_sequence", "last_sequence", "reason"],
      "properties": {
        "first_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "last_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "addressMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "load_bias"],
      "properties": {
        "method": {"const": "runtime_address_minus_load_bias"},
        "load_bias": {"type": "string", "pattern": "^-?0x[0-9a-fA-F]{1,16}$"}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gaps"],
      "properties": {
        "status": {"enum": ["complete", "sampled", "unknown"]},
        "gaps": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/gap"}}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "matched_count", "ambiguous_count", "unmatched_count", "mapping_underflow_count", "mapping_overflow_count"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "matched_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "ambiguous_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "unmatched_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "mapping_underflow_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "mapping_overflow_count": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_id", "sequence", "event_kind", "runtime_address", "normalized_address", "match_state", "matched_node_ids", "function_entries"],
      "properties": {
        "capture_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "event_kind": {"enum": ["function_entry", "function_exit", "call_target", "instruction"]},
        "runtime_address": {"type": "string", "pattern": "^(?:0x)?[0-9a-fA-F]{1,16}$"},
        "normalized_address": {"oneOf": [{"$ref": "#/$defs/address"}, {"type": "null"}]},
        "match_state": {"enum": ["matched", "ambiguous", "unmatched", "mapping_underflow", "mapping_overflow"]},
        "matched_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "function_entries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"match_state": {"const": "mapping_underflow"}}, "required": ["match_state"]}, "then": {"properties": {"normalized_address": {"const": null}, "matched_node_ids": {"maxItems": 0}, "function_entries": {"maxItems": 0}}}},
        {"if": {"properties": {"match_state": {"const": "mapping_overflow"}}, "required": ["match_state"]}, "then": {"properties": {"normalized_address": {"const": null}, "matched_node_ids": {"maxItems": 0}, "function_entries": {"maxItems": 0}}}},
        {"if": {"properties": {"match_state": {"enum": ["unmatched", "mapping_underflow", "mapping_overflow"]}}, "required": ["match_state"]}, "then": {"properties": {"matched_node_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"match_state": {"const": "matched"}}, "required": ["match_state"]}, "then": {"properties": {"matched_node_ids": {"minItems": 1, "maxItems": 1}}}},
        {"if": {"properties": {"match_state": {"const": "ambiguous"}}, "required": ["match_state"]}, "then": {"properties": {"matched_node_ids": {"minItems": 2}}}}
      ]
    }
  }
}
