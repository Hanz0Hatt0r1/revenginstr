{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/type-layout-evaluation-v1.schema.json",
  "title": "REVENGINSTR.TypeLayoutEvaluation/1",
  "description": "Coverage-aware metrics for type-layout hypotheses against independent adjudicated gold.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "dataset_id", "split_id", "type_layout_hypotheses_sha256", "gold_artifact_sha256", "layouts_evaluated", "layouts_missing", "prediction_layouts_present", "audited_field_offset_count", "gold_field_count", "candidate_field_count", "unscored_candidate_field_count", "field_offset_true_positives", "field_offset_precision", "field_offset_recall", "field_offset_f1", "compatible_type_labeled_fields", "reviewed_type_fields", "compatible_type_accuracy", "compatible_type_review_coverage", "reviewed_fields", "accepted_reviewed_fields", "reviewed_field_acceptance", "high_confidence_reviewer_acceptance", "high_confidence_reviewer_acceptance_status", "conflicted_layouts", "layout_conflict_rate", "conflicted_fields", "output_fields", "field_conflict_rate", "prototype_compatibility", "prototype_compatibility_status"],
  "properties": {
    "format": {"const": "REVENGINSTR.TypeLayoutEvaluation/1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "split_id": {"type": "string", "minLength": 1},
    "type_layout_hypotheses_sha256": {"$ref": "#/$defs/sha256"},
    "gold_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "layouts_evaluated": {"type": "integer", "minimum": 1},
    "layouts_missing": {"type": "integer", "minimum": 0},
    "prediction_layouts_present": {"type": "integer", "minimum": 0},
    "audited_field_offset_count": {"type": "integer", "minimum": 1},
    "gold_field_count": {"type": "integer", "minimum": 0},
    "candidate_field_count": {"type": "integer", "minimum": 0},
    "unscored_candidate_field_count": {"type": "integer", "minimum": 0},
    "field_offset_true_positives": {"type": "integer", "minimum": 0},
    "field_offset_precision": {"$ref": "#/$defs/nullable_ratio"},
    "field_offset_recall": {"$ref": "#/$defs/nullable_ratio"},
    "field_offset_f1": {"$ref": "#/$defs/nullable_ratio"},
    "compatible_type_labeled_fields": {"type": "integer", "minimum": 0},
    "reviewed_type_fields": {"type": "integer", "minimum": 0},
    "compatible_type_accuracy": {"$ref": "#/$defs/nullable_ratio"},
    "compatible_type_review_coverage": {"$ref": "#/$defs/nullable_ratio"},
    "reviewed_fields": {"type": "integer", "minimum": 0},
    "accepted_reviewed_fields": {"type": "integer", "minimum": 0},
    "reviewed_field_acceptance": {"$ref": "#/$defs/nullable_ratio"},
    "high_confidence_reviewer_acceptance": {"$ref": "#/$defs/nullable_ratio"},
    "high_confidence_reviewer_acceptance_status": {"const": "not_evaluated_no_confidence_score"},
    "conflicted_layouts": {"type": "integer", "minimum": 0},
    "layout_conflict_rate": {"$ref": "#/$defs/nullable_ratio"},
    "conflicted_fields": {"type": "integer", "minimum": 0},
    "output_fields": {"type": "integer", "minimum": 0},
    "field_conflict_rate": {"$ref": "#/$defs/nullable_ratio"},
    "prototype_compatibility": {"$ref": "#/$defs/nullable_ratio"},
    "prototype_compatibility_status": {"const": "not_evaluated_no_prototype_hypothesis_input"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  }
}
