{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/selective-threshold-evaluation-v1.schema.json",
  "title": "REVENGINSTR.SelectiveThresholdEvaluation/1 report",
  "description": "Held-out family evaluation of OOF-selected per-class confidence thresholds and calibration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "source", "min_train_examples", "bin_count", "targets", "classes"],
  "properties": {
    "format": {"const": "REVENGINSTR.SelectiveThresholdEvaluation/1"},
    "source": {"$ref": "#/$defs/source"},
    "min_train_examples": {"type": "integer", "minimum": 1},
    "bin_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
    },
    "classes": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"$ref": "#/$defs/classResult"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classifier_format", "manifest_sha256", "oof_predictions_sha256",
        "evaluation_predictions_sha256", "training_oof_rows", "training_oof_families",
        "evaluation_rows", "evaluation_families", "family_disjoint"
      ],
      "properties": {
        "classifier_format": {"const": "REVENGINSTR.SelectiveClassifier/1"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "oof_predictions_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_predictions_sha256": {"$ref": "#/$defs/sha256"},
        "training_oof_rows": {"type": "integer", "minimum": 1},
        "training_oof_families": {"type": "integer", "minimum": 1},
        "evaluation_rows": {"type": "integer", "minimum": 1},
        "evaluation_families": {"type": "integer", "minimum": 1},
        "family_disjoint": {"const": true}
      }
    },
    "classResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_predictions", "correct_predictions", "accuracy", "calibration", "thresholds"],
      "properties": {
        "evaluation_predictions": {"type": "integer", "minimum": 0},
        "correct_predictions": {"type": "integer", "minimum": 0},
        "accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "calibration": {"$ref": "#/$defs/reliability"},
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/threshold"}
        }
      }
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "brier_score", "expected_calibration_error", "bins"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 0},
        "brier_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "expected_calibration_error": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "bins": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/bin"}
        }
      }
    },
    "bin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower_bound", "upper_bound", "count", "mean_confidence", "observed_accuracy"],
      "properties": {
        "lower_bound": {"type": "number", "minimum": 0, "maximum": 1},
        "upper_bound": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "count": {"type": "integer", "minimum": 0},
        "mean_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "observed_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_precision", "training_status", "training_threshold", "training_precision",
        "training_coverage", "evaluation_status", "accepted_examples", "precision", "coverage"
      ],
      "properties": {
        "target_precision": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "training_status": {"enum": ["feasible", "no_predictions", "insufficient_examples", "target_unmet"]},
        "training_threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "training_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "training_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "evaluation_status": {"enum": ["measured", "no_predictions", "unavailable"]},
        "accepted_examples": {"type": "integer", "minimum": 0},
        "precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
