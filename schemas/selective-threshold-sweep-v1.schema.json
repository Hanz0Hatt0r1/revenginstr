{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/selective-threshold-sweep-v1.schema.json",
  "title": "REVENGINSTR.SelectiveThresholdSweep/1 report",
  "description": "Audit-only per-class confidence threshold sweep over family-grouped out-of-fold predictions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "source", "min_examples", "targets", "classes"],
  "properties": {
    "format": {"const": "REVENGINSTR.SelectiveThresholdSweep/1"},
    "source": {"$ref": "#/$defs/source"},
    "min_examples": {"type": "integer", "minimum": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
    },
    "classes": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"$ref": "#/$defs/classResult"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classifier_format", "manifest_sha256", "predictions_sha256", "prediction_rows", "families"],
      "properties": {
        "classifier_format": {"const": "REVENGINSTR.SelectiveClassifier/1"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "predictions_sha256": {"$ref": "#/$defs/sha256"},
        "prediction_rows": {"type": "integer", "minimum": 1},
        "families": {"type": "integer", "minimum": 1}
      }
    },
    "classResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicted_examples", "correct_predictions", "baseline_precision", "sweeps"],
      "properties": {
        "predicted_examples": {"type": "integer", "minimum": 0},
        "correct_predictions": {"type": "integer", "minimum": 0},
        "baseline_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "sweeps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sweep"}
        }
      }
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_precision", "status", "threshold", "precision", "accepted_examples", "coverage"],
      "properties": {
        "target_precision": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "status": {"enum": ["feasible", "no_predictions", "insufficient_examples", "target_unmet"]},
        "threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "accepted_examples": {"type": "integer", "minimum": 0},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "feasible"}}, "required": ["status"]},
          "then": {
            "properties": {
              "threshold": {"type": "number"},
              "precision": {"type": "number"},
              "accepted_examples": {"minimum": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["no_predictions", "insufficient_examples", "target_unmet"]}}, "required": ["status"]},
          "then": {
            "properties": {
              "threshold": {"type": "null"},
              "precision": {"type": "null"},
              "accepted_examples": {"const": 0},
              "coverage": {"const": 0}
            }
          }
        }
      ]
    }
  }
}
