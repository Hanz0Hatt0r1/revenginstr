{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/ghidra-caller-argument-parameter-root-v3.schema.json",
  "title": "REVENGINSTR.GhidraCallerArgumentParameterRoot/3 TSV row",
  "description": "Program-pinned evidence that a direct call argument is exactly a formal parameter of the caller.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "program_id", "program_sha256", "plan_id", "callee_entry", "parameter_index",
    "caller_entry", "caller_call_site", "caller_parameter_index", "argument_node_id", "status"
  ],
  "properties": {
    "format": {"const": "REVENGINSTR.GhidraCallerArgumentParameterRoot/3"},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_id": {"type": "string", "minLength": 1},
    "callee_entry": {"type": "string", "minLength": 1},
    "parameter_index": {"type": "string", "pattern": "^[0-9]+$"},
    "caller_entry": {"type": "string", "minLength": 1},
    "caller_call_site": {"type": "string", "minLength": 1},
    "caller_parameter_index": {"type": "string", "pattern": "^[0-9]+$"},
    "argument_node_id": {"type": "string", "pattern": "^[0-9]+$"},
    "status": {"const": "direct_parameter_root"}
  }
}
