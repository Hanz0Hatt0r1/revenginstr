{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/runtime-transform-replay-manifest-v1.schema.json",
  "title": "REVENGINSTR.RuntimeTransformReplayManifest/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "capture_id", "candidate_id", "behavior_id", "expected_function_node_id", "correlation_report_sha256", "observations_sha256", "source_capture_sha256", "probe_script_sha256"],
  "properties": {
    "format": {"const": "REVENGINSTR.RuntimeTransformReplayManifest/1"},
    "capture_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "behavior_id": {"type": "string", "minLength": 1},
    "expected_function_node_id": {"type": "string", "minLength": 1},
    "correlation_report_sha256": {"$ref": "#/$defs/sha256"},
    "observations_sha256": {"$ref": "#/$defs/sha256"},
    "source_capture_sha256": {"$ref": "#/$defs/sha256"},
    "probe_script_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
