{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/ghidra-indirect-call-symbol-candidates-v1.schema.json",
  "title": "REVENGINSTR.GhidraIndirectCallSymbolCandidates/1 JSONL row",
  "description": "Manually reviewed, source-pinned symbolic target candidates joined to one exact indirect-call site; this does not establish runtime selection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "program_id", "program_sha256", "function_entry", "call_address", "call_time", "candidates"
  ],
  "properties": {
    "format": {"const": "REVENGINSTR.GhidraIndirectCallSymbolCandidates/1"},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "function_entry": {"$ref": "#/$defs/address"},
    "call_address": {"$ref": "#/$defs/address"},
    "call_time": {"type": "integer", "minimum": 0},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^(?:(?:[A-Za-z_$][\\w$]*):)?(?:0x)?[0-9a-fA-F]+$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_format", "artifact_path", "artifact_sha256", "record_index"],
      "properties": {
        "source_format": {"type": "string", "minLength": 1},
        "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_index": {"type": "integer", "minimum": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_kind", "module", "symbol", "address", "alternative_indexes", "evidence_refs", "limitations"
      ],
      "properties": {
        "candidate_kind": {"enum": ["external_api", "internal_function"]},
        "module": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "address": {"type": ["string", "null"], "pattern": "^(?:(?:[A-Za-z_$][\\w$]*):)?(?:0x)?[0-9a-fA-F]+$"},
        "alternative_indexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceRef"}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"candidate_kind": {"const": "external_api"}}, "required": ["candidate_kind"]},
          "then": {"properties": {"address": {"type": "null"}}}
        },
        {
          "if": {"properties": {"candidate_kind": {"const": "internal_function"}}, "required": ["candidate_kind"]},
          "then": {"properties": {"address": {"type": "string"}}}
        }
      ]
    }
  }
}
