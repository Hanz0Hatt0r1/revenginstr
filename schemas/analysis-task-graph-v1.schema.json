{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/analysis-task-graph-v1.schema.json",
  "title": "REVENGINSTR.AnalysisTaskGraph/1 input",
  "description": "Project-neutral dependency graph for bounded analysis tasks and their artifact inputs/outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "tasks"
  ],
  "properties": {
    "format": {
      "const": "REVENGINSTR.AnalysisTaskGraph/1"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_kind",
        "configuration_sha256",
        "depends_on",
        "input_artifacts",
        "output_artifacts"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "task_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "input_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "output_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
