{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/ghidra-caller-argument-parameter-root-v2.schema.json",
  "title": "REVENGINSTR.GhidraCallerArgumentParameterRoot/2 TSV row",
  "description": "An actual call argument equal to one caller formal parameter plus an exact signed constant byte offset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "plan_id", "callee_entry", "parameter_index", "caller_entry",
    "caller_call_site", "caller_parameter_index", "caller_parameter_offset_bytes",
    "argument_node_id", "status"
  ],
  "properties": {
    "format": {"const": "REVENGINSTR.GhidraCallerArgumentParameterRoot/2"},
    "plan_id": {"type": "string", "minLength": 1},
    "callee_entry": {"type": "string", "minLength": 1},
    "parameter_index": {"type": "string", "pattern": "^[0-9]+$"},
    "caller_entry": {"type": "string", "minLength": 1},
    "caller_call_site": {"type": "string", "minLength": 1},
    "caller_parameter_index": {"type": "string", "pattern": "^[0-9]+$"},
    "caller_parameter_offset_bytes": {
      "type": "string",
      "pattern": "^(?:0x(?:0|[1-9a-f][0-9a-f]*)|-0x[1-9a-f][0-9a-f]*)$"
    },
    "argument_node_id": {"type": "string", "pattern": "^[0-9]+$"},
    "status": {"const": "constant_offset_parameter_root"}
  }
}
