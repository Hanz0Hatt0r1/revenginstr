{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/runtime-value-flow-replay-v1.schema.json",
  "title": "REVENGINSTR.RuntimeValueFlowReplay/1",
  "description": "Pair-scoped replay outcomes over hash-pinned opaque-token observations. A result never asserts that an unobserved static path is absent or exact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "capture_id", "program_id", "program_sha256", "semantic_graph_sha256", "correlation_report_sha256", "observations_sha256", "sampling", "claim_scope", "token_provenance", "summary", "candidates"],
  "properties": {
    "format": {"const": "REVENGINSTR.RuntimeValueFlowReplay/1"},
    "capture_id": {"type": "string", "minLength": 1},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_graph_sha256": {"$ref": "#/$defs/sha256"},
    "correlation_report_sha256": {"$ref": "#/$defs/sha256"},
    "observations_sha256": {"$ref": "#/$defs/sha256"},
    "sampling": {"$ref": "#/$defs/sampling"},
    "claim_scope": {"const": "selected_observation_pairs_only"},
    "token_provenance": {"type": "string", "minLength": 1},
    "summary": {"$ref": "#/$defs/summary"},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["first_sequence", "last_sequence", "reason"],
      "properties": {
        "first_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "last_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "sampling": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "gaps"],
      "properties": {
        "status": {"enum": ["complete", "sampled", "unknown"]},
        "gaps": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/gap"}}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_count", "witnessed", "observed_mismatch", "inconclusive"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "witnessed": {"type": "integer", "minimum": 0, "maximum": 10000},
        "observed_mismatch": {"type": "integer", "minimum": 0, "maximum": 10000},
        "inconclusive": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "relation_kind", "source_sequence", "sink_sequence", "expected_source_node_id", "expected_sink_node_id", "status", "reason", "compared_token_slots", "intervening_coverage"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "relation_kind": {"enum": ["receiver_identity", "field_write_read", "state_transition", "factory_return_use", "allocation_release"]},
        "source_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "sink_sequence": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "expected_source_node_id": {"type": "string", "minLength": 1},
        "expected_sink_node_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["witnessed", "observed_mismatch", "inconclusive"]},
        "reason": {"type": "string", "minLength": 1},
        "compared_token_slots": {"type": "array", "uniqueItems": true, "items": {"enum": ["subject", "field", "value"]}},
        "different_token_slots": {"type": "array", "uniqueItems": true, "items": {"enum": ["subject", "field", "value"]}},
        "intervening_coverage": {"enum": ["complete", "not_established"]}
      }
    }
  }
}
