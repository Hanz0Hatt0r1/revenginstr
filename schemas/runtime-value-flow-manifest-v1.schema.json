{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/runtime-value-flow-manifest-v1.schema.json",
  "title": "REVENGINSTR.RuntimeValueFlowManifest/1",
  "description": "Pins one runtime address-correlation report, opaque value observations, and an explicit list of candidate event pairs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "capture_id", "correlation_report_sha256", "observations_sha256", "candidates"],
  "properties": {
    "format": {"const": "REVENGINSTR.RuntimeValueFlowManifest/1"},
    "capture_id": {"type": "string", "minLength": 1},
    "correlation_report_sha256": {"$ref": "#/$defs/sha256"},
    "observations_sha256": {"$ref": "#/$defs/sha256"},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "relation_kind", "source_sequence", "sink_sequence", "expected_source_node_id", "expected_sink_node_id"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "relation_kind": {"enum": ["receiver_identity", "field_write_read", "state_transition", "factory_return_use", "call_output_return", "allocation_release"]},
        "source_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "sink_sequence": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "expected_source_node_id": {"type": "string", "minLength": 1},
        "expected_sink_node_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
