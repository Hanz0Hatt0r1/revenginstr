{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/runtime-direct-call-observation-v1.schema.json",
  "title": "REVENGINSTR.RuntimeDirectCallObservation/1 JSONL row",
  "description": "One bounded runtime direct-call observation with the exact call instruction address and executed target entry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "capture_id", "sequence", "callsite_runtime_address", "target_runtime_address"],
  "properties": {
    "format": {"const": "REVENGINSTR.RuntimeDirectCallObservation/1"},
    "capture_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "callsite_runtime_address": {"$ref": "#/$defs/address"},
    "target_runtime_address": {"$ref": "#/$defs/address"}
  },
  "$defs": {"address": {"type": "string", "pattern": "^(?:0x)?[0-9a-fA-F]{1,16}$"}}
}
