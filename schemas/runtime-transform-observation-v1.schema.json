{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/runtime-transform-observation-v1.schema.json",
  "title": "REVENGINSTR.RuntimeTransformObservation/1",
  "description": "A bounded consumer-reported transform result tied to one exact runtime function-entry correlation event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "capture_id", "correlation_sequence", "runtime_address", "event_kind", "behavior_id", "source_ordinal", "input_length", "key", "sample_mode", "sample_count", "formula_result", "probe_script_sha256"],
  "properties": {
    "format": {"const": "REVENGINSTR.RuntimeTransformObservation/1"},
    "capture_id": {"type": "string", "minLength": 1},
    "correlation_sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "runtime_address": {"type": "string", "pattern": "^(0x)?[0-9a-fA-F]{1,16}$"},
    "event_kind": {"const": "function_entry"},
    "behavior_id": {"type": "string", "minLength": 1},
    "source_ordinal": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "input_length": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "key": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "sample_mode": {"enum": ["none", "full", "bounded"]},
    "sample_count": {"type": "integer", "minimum": 0, "maximum": 128},
    "formula_result": {"enum": ["match", "mismatch", "unavailable"]},
    "probe_script_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "allOf": [
    {"if": {"properties": {"sample_mode": {"const": "none"}}, "required": ["sample_mode"]}, "then": {"properties": {"sample_count": {"const": 0}, "formula_result": {"const": "unavailable"}}}},
    {"if": {"properties": {"sample_mode": {"const": "full"}}, "required": ["sample_mode"]}, "then": {"properties": {"input_length": {"minimum": 1, "maximum": 128}, "sample_count": {"minimum": 1}}}},
    {"if": {"properties": {"sample_mode": {"const": "bounded"}}, "required": ["sample_mode"]}, "then": {"properties": {"input_length": {"minimum": 129}, "sample_count": {"minimum": 1}}}},
    {"if": {"properties": {"formula_result": {"enum": ["match", "mismatch"]}}, "required": ["formula_result"]}, "then": {"properties": {"sample_count": {"minimum": 1}}}}
  ]
}
