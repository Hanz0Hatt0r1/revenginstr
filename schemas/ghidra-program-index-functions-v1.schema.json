{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/ghidra-program-index-functions-v1.schema.json",
  "$comment": "Object representation of one UTF-8 TSV row. The exact header is defined in docs/GHIDRA_PROGRAM_INDEX.md; the wire cells are strings.",
  "title": "REVENGINSTR.GhidraProgramIndex.Functions/1 TSV row",
  "type": "object",
  "required": ["entry", "name", "address_count", "is_external", "signature"],
  "properties": {
    "entry": {"type": "string", "description": "Ghidra function entry address."},
    "name": {"type": "string"},
    "address_count": {"type": "string", "pattern": "^[0-9]+$"},
    "is_external": {"enum": ["true", "false"]},
    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
