{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/analysis-feedback-v1.schema.json",
  "title": "REVENGINSTR.AnalysisFeedback/1 JSONL row",
  "description": "Consumer-owned reviewer feedback with explicit target, reviewer metadata, evidence lineage, and no automatic training eligibility.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "feedback_id", "target", "status", "reviewer", "provenance_quality", "evidence", "training_eligible"],
  "properties": {
    "format": {"const": "REVENGINSTR.AnalysisFeedback/1"},
    "feedback_id": {"type": "string", "minLength": 1},
    "target": {"$ref": "#/$defs/target"},
    "status": {"enum": ["confirmed", "rejected", "partially_correct", "ambiguous", "needs_more_evidence"]},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "provenance_quality": {"enum": ["direct", "corroborated", "indirect", "unverified"]},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "training_eligible": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_format", "artifact_sha256", "record_index", "subject_kind", "subject_id"],
      "properties": {
        "artifact_format": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "record_index": {"type": "integer", "minimum": 1},
        "subject_kind": {"enum": ["function", "family", "claim", "decision"]},
        "subject_id": {"type": "string", "minLength": 1}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "kind", "qualification"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["human", "automated_tool", "unknown"]},
        "qualification": {"enum": ["expert", "trained", "peer", "automated", "unknown"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "automated_tool"}}, "required": ["kind"]}, "then": {"properties": {"qualification": {"const": "automated"}}}},
        {"if": {"properties": {"kind": {"const": "human"}}, "required": ["kind"]}, "then": {"properties": {"qualification": {"enum": ["expert", "trained", "peer", "unknown"]}}}},
        {"if": {"properties": {"kind": {"const": "unknown"}}, "required": ["kind"]}, "then": {"properties": {"qualification": {"const": "unknown"}}}}
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_format", "artifact_sha256", "record_index", "evidence_class"],
      "properties": {
        "artifact_format": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "record_index": {"type": "integer", "minimum": 1},
        "evidence_class": {"enum": ["exact_static", "runtime_native", "derived_structural", "model_prediction", "human_review", "interventional_probe"]}
      }
    }
  }
}
