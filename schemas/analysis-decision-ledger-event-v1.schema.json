{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/analysis-decision-ledger-event-v1.schema.json",
  "title": "REVENGINSTR.AnalysisDecisionLedgerEvent/1 JSONL row",
  "description": "One consumer-owned state transition with responsible actor, reason codes, confidence delta, and added evidence references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "analysis_id", "event_id", "subject_id", "subject_kind", "subject_provenance", "event_index", "previous_state", "state", "reason_codes", "responsible", "confidence_delta", "evidence_added"],
  "properties": {
    "format": {"const": "REVENGINSTR.AnalysisDecisionLedgerEvent/1"},
    "analysis_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_kind": {"enum": ["function", "family", "claim", "decision"]},
    "subject_provenance": {"$ref": "#/$defs/subjectProvenance"},
    "event_index": {"type": "integer", "minimum": 1},
    "previous_state": {"$ref": "#/$defs/nullableState"},
    "state": {"$ref": "#/$defs/state"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}},
    "responsible": {"$ref": "#/$defs/responsible"},
    "confidence_delta": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "evidence_added": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "state": {"enum": ["accepted_exact", "accepted_high_confidence", "review_required", "escalated_conflict", "unsupported", "budget_exhausted"]},
    "nullableState": {"oneOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]},
    "reason": {"enum": ["exact_evidence", "high_confidence", "out_of_distribution", "evidence_conflict", "unsupported_pattern", "missing_evidence", "budget_exhausted", "human_review"]},
    "subjectProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_format", "artifact_sha256", "record_index"],
      "properties": {
        "source_format": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_index": {"type": "integer", "minimum": 1}
      }
    },
    "responsible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["rule", "model", "human", "orchestrator"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_format", "artifact_sha256", "record_index", "evidence_class"],
      "properties": {
        "source_format": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_index": {"type": "integer", "minimum": 1},
        "evidence_class": {"enum": ["exact_static", "runtime_native", "derived_structural", "model_prediction", "human_review", "interventional_probe"]}
      }
    }
  }
}
