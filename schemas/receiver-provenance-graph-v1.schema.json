{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/receiver-provenance-graph-v1.schema.json",
  "title": "REVENGINSTR.ReceiverProvenanceGraph/1 record",
  "description": "Project-neutral receiver-flow graph. Node ids are graph-local; source identities and evidence details remain opaque provenance references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "graph_id", "nodes", "edges"],
  "properties": {
    "format": {"const": "REVENGINSTR.ReceiverProvenanceGraph/1"},
    "graph_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "parameter",
            "local",
            "field_load",
            "field_store",
            "return",
            "call_argument",
            "indirect_call",
            "phi",
            "global",
            "constructor",
            "factory",
            "singleton",
            "vtable_write",
            "receiver"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "relation", "evidence_class", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "relation": {
          "enum": [
            "data_flow",
            "argument_flow",
            "return_flow",
            "field_store",
            "field_load",
            "phi_input",
            "constructs",
            "factory_return",
            "singleton_reference",
            "vtable_write",
            "receiver_at_call",
            "alias"
          ]
        },
        "evidence_class": {
          "enum": [
            "exact_static",
            "runtime_native",
            "derived_structural",
            "model_prediction",
            "human_review",
            "interventional_probe"
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/provenance"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_format", "source_id"],
      "properties": {
        "source_format": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
