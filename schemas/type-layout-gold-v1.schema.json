{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/type-layout-gold-v1.schema.json",
  "title": "REVENGINSTR.TypeLayoutGold/1 record",
  "description": "Independently adjudicated positive fields and explicit field-presence coverage for one frozen type layout.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "dataset_id", "split_id", "program_id", "program_sha256", "type_id", "audited_field_offsets", "fields", "adjudication_status"],
  "properties": {
    "format": {"const": "REVENGINSTR.TypeLayoutGold/1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "split_id": {"type": "string", "minLength": 1},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "type_id": {"type": "string", "minLength": 1},
    "audited_field_offsets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "adjudication_status": {"const": "adjudicated"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_sha256", "record_index", "source_format"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "record_index": {"type": "integer", "minimum": 1},
        "source_format": {"type": "string", "minLength": 1}
      }
    },
    "compatible_type": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "width_bytes"],
      "properties": {
        "kind": {"enum": ["boolean", "integer", "floating_point", "data_pointer", "function_pointer", "aggregate", "bitfield", "opaque_bytes"]},
        "width_bytes": {"type": ["integer", "null"], "minimum": 1},
        "target_type_id": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"target_type_id": {"type": "string"}}, "required": ["target_type_id"]}, "then": {"properties": {"kind": {"const": "data_pointer"}}}}]
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["offset_bytes", "evidence_refs"],
      "properties": {
        "offset_bytes": {"type": "integer", "minimum": 0},
        "compatible_types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/compatible_type"}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    }
  }
}
