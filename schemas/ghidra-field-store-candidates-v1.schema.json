{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/ghidra-field-store-candidates-v1.schema.json",
  "title": "REVENGINSTR.GhidraFieldStoreCandidates/1 TSV row",
  "description": "One bounded High-P-code STORE candidate. Address and function-name cells are metadata from the selected program; a caller-supplied function-name filter and field offset scope the export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "function_entry", "function_name", "store_address", "store_time",
    "field_offset_hex", "address_opcode", "address_op_address", "address_op_time",
    "base_token", "value_token", "value_is_constant", "value_constant_hex"
  ],
  "properties": {
    "function_entry": {"type": "string", "minLength": 1},
    "function_name": {"type": "string", "minLength": 1},
    "store_address": {"type": "string", "minLength": 1},
    "store_time": {"type": "string", "pattern": "^[0-9]+$"},
    "field_offset_hex": {"type": "string", "pattern": "^0x[0-9a-f]+$"},
    "address_opcode": {"type": "string", "minLength": 1},
    "address_op_address": {"type": "string", "minLength": 1},
    "address_op_time": {"type": "string", "pattern": "^[0-9]+$"},
    "base_token": {"type": "string", "minLength": 1},
    "value_token": {"type": "string", "minLength": 1},
    "value_is_constant": {"enum": ["0", "1"]},
    "value_constant_hex": {"type": "string", "pattern": "^(?:-|0x[0-9a-f]+)$"}
  },
  "allOf": [
    {
      "if": {"properties": {"value_is_constant": {"const": "1"}}},
      "then": {"properties": {"value_constant_hex": {"pattern": "^0x[0-9a-f]+$"}}},
      "else": {"properties": {"value_constant_hex": {"const": "-"}}}
    }
  ]
}
