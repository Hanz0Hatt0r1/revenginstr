{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/type-layout-hypothesis-v1.schema.json",
  "title": "REVENGINSTR.TypeLayoutHypothesis/1 record",
  "description": "Evidence-linked candidate object layout. Fields, types, vtable anchors, and relationships remain hypotheses unless separately adjudicated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "program_id",
    "program_sha256",
    "type_id",
    "architecture",
    "status",
    "object_size",
    "fields",
    "vtable_anchors",
    "relationships",
    "conflicts"
  ],
  "properties": {
    "format": {"const": "REVENGINSTR.TypeLayoutHypothesis/1"},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "type_id": {"type": "string", "minLength": 1},
    "architecture": {"$ref": "#/$defs/architecture"},
    "status": {"enum": ["candidate", "review", "conflicted"]},
    "object_size": {"$ref": "#/$defs/object_size"},
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "vtable_anchors": {"type": "array", "items": {"$ref": "#/$defs/vtable_anchor"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "conflicted"}}, "required": ["status"]},
      "then": {"properties": {"conflicts": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language_id", "pointer_width_bytes", "addressable_unit_bytes", "endianness"],
      "properties": {
        "language_id": {"type": "string", "minLength": 1},
        "pointer_width_bytes": {"type": "integer", "minimum": 1},
        "addressable_unit_bytes": {"type": "integer", "minimum": 1},
        "endianness": {"enum": ["little", "big"]}
      }
    },
    "evidence_class": {
      "enum": [
        "exact_static",
        "runtime_native",
        "derived_structural",
        "human_review",
        "interventional_probe"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_format", "source_sha256", "record_key", "evidence_class"],
      "properties": {
        "source_format": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "record_key": {"type": "string", "minLength": 1},
        "source_pointer": {"type": "string", "minLength": 1},
        "evidence_class": {"$ref": "#/$defs/evidence_class"}
      }
    },
    "object_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_observed_bytes", "exact_size_bytes", "evidence"],
      "properties": {
        "minimum_observed_bytes": {"type": ["integer", "null"], "minimum": 1},
        "exact_size_bytes": {"type": ["integer", "null"], "minimum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "allOf": [
        {
          "if": {"properties": {"minimum_observed_bytes": {"type": "integer"}}, "required": ["minimum_observed_bytes"]},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"exact_size_bytes": {"type": "integer"}}, "required": ["exact_size_bytes"]},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        }
      ]
    },
    "field_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "width_bytes", "evidence"],
      "properties": {
        "kind": {"enum": ["read", "write", "address"]},
        "width_bytes": {"type": ["integer", "null"], "minimum": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "type_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "width_bytes", "evidence"],
      "properties": {
        "kind": {
          "enum": [
            "boolean",
            "integer",
            "floating_point",
            "data_pointer",
            "function_pointer",
            "aggregate",
            "bitfield",
            "opaque_bytes"
          ]
        },
        "width_bytes": {"type": ["integer", "null"], "minimum": 1},
        "target_type_id": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      },
      "allOf": [
        {
          "if": {"properties": {"target_type_id": {"type": "string"}}, "required": ["target_type_id"]},
          "then": {"properties": {"kind": {"const": "data_pointer"}}}
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_bytes", "status", "accesses", "type_candidates", "conflicts"],
      "properties": {
        "offset_bytes": {"type": "integer", "minimum": 0},
        "status": {"enum": ["candidate", "review", "conflicted"]},
        "accesses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field_access"}},
        "type_candidates": {"type": "array", "items": {"$ref": "#/$defs/type_candidate"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "conflicted"}}, "required": ["status"]},
          "then": {"properties": {"conflicts": {"minItems": 1}}}
        }
      ]
    },
    "vtable_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "status", "evidence"],
      "properties": {
        "address": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate", "review", "conflicted"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_type_id", "offset_bytes", "status", "evidence", "conflicts"],
      "properties": {
        "kind": {"enum": ["inherits", "contains", "points_to"]},
        "target_type_id": {"type": "string", "minLength": 1},
        "offset_bytes": {"type": ["integer", "null"], "minimum": 0},
        "status": {"enum": ["candidate", "review", "conflicted"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "conflicted"}}, "required": ["status"]},
          "then": {"properties": {"conflicts": {"minItems": 1}}}
        }
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "evidence"],
      "properties": {
        "reason": {
          "enum": [
            "overlapping_field_candidates",
            "incompatible_widths",
            "size_bound_conflict",
            "vtable_anchor_conflict",
            "base_relationship_conflict",
            "evidence_conflict",
            "unsupported_identity",
            "other"
          ]
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
