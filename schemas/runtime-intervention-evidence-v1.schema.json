{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/runtime-intervention-evidence-v1.schema.json",
  "title": "REVENGINSTR.RuntimeInterventionEvidence/1",
  "description": "Ranks repeated differential signatures and promotes only fully observed, same-direction changes across at least three independent pairs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "collection_id", "manifest_sha256", "program_id", "program_sha256", "semantic_graph_sha256", "static_identity_sha256", "intervention", "observation_window_sha256", "required_repetitions", "comparison_ids", "comparison_report_sha256", "sampling", "summary", "ranked_candidates"],
  "properties": {
    "format": {"const": "REVENGINSTR.RuntimeInterventionEvidence/1"},
    "collection_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_graph_sha256": {"$ref": "#/$defs/sha256"},
    "static_identity_sha256": {"$ref": "#/$defs/sha256"},
    "intervention": {"$ref": "#/$defs/intervention"},
    "observation_window_sha256": {"$ref": "#/$defs/sha256"},
    "required_repetitions": {"const": 3},
    "comparison_ids": {"type": "array", "minItems": 3, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "comparison_report_sha256": {"type": "array", "minItems": 3, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "sampling": {"$ref": "#/$defs/sampling"},
    "summary": {"$ref": "#/$defs/summary"},
    "ranked_candidates": {"type": "array", "maxItems": 200000, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "name", "baseline_label", "treatment_label", "fixed_context_sha256"],
      "properties": {
        "dimension": {"enum": ["input", "state", "action"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "baseline_label": {"type": "string", "minLength": 1, "maxLength": 256},
        "treatment_label": {"type": "string", "minLength": 1, "maxLength": 256},
        "fixed_context_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "samplingPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_id", "baseline_status", "treatment_status", "complete"],
      "properties": {
        "comparison_id": {"type": "string", "minLength": 1},
        "baseline_status": {"enum": ["complete", "sampled", "unknown"]},
        "treatment_status": {"enum": ["complete", "sampled", "unknown"]},
        "complete": {"type": "boolean"}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_count", "complete_pair_count", "all_complete", "pairs"],
      "properties": {
        "comparison_count": {"type": "integer", "minimum": 3, "maximum": 100},
        "complete_pair_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "all_complete": {"type": "boolean"},
        "pairs": {"type": "array", "minItems": 3, "maxItems": 100, "items": {"$ref": "#/$defs/samplingPair"}}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_count", "intervention_support_count", "correlation_count"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0, "maximum": 200000},
        "intervention_support_count": {"type": "integer", "minimum": 0, "maximum": 200000},
        "correlation_count": {"type": "integer", "minimum": 0, "maximum": 200000}
      }
    },
    "pairDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_id", "delta"],
      "properties": {
        "comparison_id": {"type": "string", "minLength": 1},
        "delta": {"type": "integer", "minimum": -100000, "maximum": 100000}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "event_kind", "normalized_address", "direction", "pair_count", "positive_pair_count", "negative_pair_count", "unchanged_pair_count", "support_repetition_count", "support_fraction", "median_delta", "pairwise_deltas", "matched_node_ids", "function_entries", "evidence_class"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "event_kind": {"enum": ["function_entry", "function_exit", "call_target", "instruction"]},
        "normalized_address": {"type": "string", "pattern": "^0x[0-9a-f]{1,16}$"},
        "direction": {"enum": ["increase", "decrease", "mixed"]},
        "pair_count": {"type": "integer", "minimum": 3, "maximum": 100},
        "positive_pair_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "negative_pair_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "unchanged_pair_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "support_repetition_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "support_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "median_delta": {"type": "number", "minimum": -100000, "maximum": 100000},
        "pairwise_deltas": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/pairDelta"}},
        "matched_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "function_entries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_class": {"enum": ["correlation", "intervention_support"]}
      }
    }
  }
}
