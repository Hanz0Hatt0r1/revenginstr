{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/ghidra-static-indirect-call-target-v1.schema.json",
  "title": "REVENGINSTR.GhidraStaticIndirectCallTarget/1 record",
  "description": "A statically resolved indirect-call target for one observed global-singleton initialization path, with the caller and vtable evidence kept explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "program_id", "program_sha256", "binary_program",
    "function_entry", "call_address", "call_time", "resolution_scope",
    "receiver", "slot", "target_address", "callind_evidence",
    "pointer_slot_projection", "initialization_evidence",
    "observed_callers", "limitations"
  ],
  "properties": {
    "format": {"const": "REVENGINSTR.GhidraStaticIndirectCallTarget/1"},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binary_program": {"type": "string", "minLength": 1},
    "function_entry": {"$ref": "#/$defs/address"},
    "call_address": {"$ref": "#/$defs/address"},
    "call_time": {"type": "integer", "minimum": 0},
    "resolution_scope": {"const": "observed_global_singleton_initializer"},
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "getter_entry", "pointer_slot_address", "object_address", "vtable_address"],
      "properties": {
        "kind": {"const": "global_singleton_pointer"},
        "getter_entry": {"$ref": "#/$defs/address"},
        "pointer_slot_address": {"$ref": "#/$defs/address"},
        "object_address": {"$ref": "#/$defs/address"},
        "vtable_address": {"$ref": "#/$defs/address"}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_bytes", "address", "raw_u32"],
      "properties": {
        "offset_bytes": {"type": "integer", "minimum": 0},
        "address": {"$ref": "#/$defs/address"},
        "raw_u32": {"type": "string", "pattern": "^0x[0-9a-fA-F]{8}$"}
      }
    },
    "target_address": {"$ref": "#/$defs/address"},
    "callind_evidence": {"$ref": "#/$defs/evidence_ref"},
    "pointer_slot_projection": {"$ref": "#/$defs/evidence_ref"},
    "initialization_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "getter_return", "singleton_initializer_call", "singleton_copy_store",
        "factory_thunk_call", "factory_constructor_call", "object_vtable_store",
        "object_vtable_value", "vtable_slot"
      ],
      "properties": {
        "getter_return": {"$ref": "#/$defs/evidence_ref"},
        "singleton_initializer_call": {"$ref": "#/$defs/evidence_ref"},
        "singleton_copy_store": {"$ref": "#/$defs/evidence_ref"},
        "factory_thunk_call": {"$ref": "#/$defs/evidence_ref"},
        "factory_constructor_call": {"$ref": "#/$defs/evidence_ref"},
        "object_vtable_store": {"$ref": "#/$defs/evidence_ref"},
        "object_vtable_value": {"$ref": "#/$defs/evidence_ref"},
        "vtable_slot": {"$ref": "#/$defs/evidence_ref"}
      }
    },
    "observed_callers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caller_entry", "call_address", "getter_call_address", "argument_index",
          "call_flow", "getter_flow", "caller_xref", "argument_provenance"
        ],
        "properties": {
          "caller_entry": {"$ref": "#/$defs/address"},
          "call_address": {"$ref": "#/$defs/address"},
          "getter_call_address": {"$ref": "#/$defs/address"},
          "argument_index": {"const": 0},
          "call_flow": {"$ref": "#/$defs/evidence_ref"},
          "getter_flow": {"$ref": "#/$defs/evidence_ref"},
          "caller_xref": {"$ref": "#/$defs/evidence_ref"},
          "argument_provenance": {"$ref": "#/$defs/evidence_ref"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{8}$"},
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256", "record_index", "source_format"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_index": {"type": "integer", "minimum": 1},
        "source_format": {"type": "string", "minLength": 1}
      }
    }
  }
}
