{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/function-families-v1.schema.json",
  "title": "REVENGINSTR.FunctionFamilies/1 JSONL row",
  "type": "object",
  "required": ["format", "id", "family_id", "family_size", "portable_hash", "feature_count"],
  "properties": {
    "format": {"const": "REVENGINSTR.FunctionFamilies/1"},
    "id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "pattern": "^family-[0-9a-f]{20}$"},
    "family_size": {"type": "integer", "minimum": 1},
    "portable_hash": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "feature_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
