{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/analysis-task-cache-restore-targets-v1.schema.json",
  "title": "REVENGINSTR.AnalysisTaskCacheRestoreTargets/1 manifest",
  "description": "Caller-selected relative output paths for restoring one task's verified cache artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "task_id", "cache_key_sha256", "targets"],
  "properties": {
    "format": {"const": "REVENGINSTR.AnalysisTaskCacheRestoreTargets/1"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "cache_key_sha256": {"$ref": "#/$defs/sha256"},
    "targets": {
      "type": "array",
      "items": {"$ref": "#/$defs/target"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "relative_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
        }
      }
    }
  }
}
