{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hanz0Hatt0r1/revenginstr/schemas/kpi-dashboard-v1.schema.json",
  "title": "REVENGINSTR.KPIDashboard/1",
  "type": "object",
  "required": ["format", "manifest_sha256", "dashboard", "status", "sources", "kpis"],
  "properties": {
    "format": {"const": "REVENGINSTR.KPIDashboard/1"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dashboard": {
      "type": "object",
      "required": ["id", "title", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["pass", "fail", "incomplete"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "format", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "source", "json_pointer", "value", "display_value", "unit", "minimum", "maximum", "target", "status", "reason", "note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "json_pointer": {"type": "string"},
          "value": {"type": ["number", "null"]},
          "display_value": {"type": "string"},
          "unit": {"enum": ["fraction", "percent", "count", "score", "seconds"]},
          "minimum": {"type": ["number", "null"]},
          "maximum": {"type": ["number", "null"]},
          "target": {"type": "string"},
          "status": {"enum": ["pass", "fail", "unavailable"]},
          "reason": {"type": ["string", "null"]},
          "note": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
